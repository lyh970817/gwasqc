nextflow_process {

    name "Test Process MISSINGNESS_LADDER"
    script "../main.nf"
    process "MISSINGNESS_LADDER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "missingness_ladder"

    // Three cumulative rungs of a synthetic stratum of ten variants and five samples stand in for the
    // pipeline's ten: rung 90 excludes v1 and removes s1; rung 91 adds v2 and nothing else; rung 92 adds s2.
    // The module only counts the lists, so the subworkflow test covers the real chain.
    test("synthetic - three cumulative rungs") {

        when {
            process {
                """
                def snplist = file("${workDir}/stratum.maf.snplist")
                snplist.text = (1..10).collect { k -> 'v' + k }.join('\\n') + '\\n'
                def fam = file("${workDir}/stratum.fam")
                fam.text = (1..5).collect { k -> 's' + k + ' s' + k + ' 0 0 1 -9' }.join('\\n') + '\\n'
                def lists = [
                    90: [['v1'], ['s1 s1']],
                    91: [['v1', 'v2'], ['s1 s1']],
                    92: [['v1', 'v2'], ['s1 s1', 's2 s2']],
                ]
                def geno = lists.collect { rate, pair -> def f = file("${workDir}/stratum.rung" + rate + ".geno_exclude.txt"); f.text = pair[0].join('\\n') + '\\n'; f }
                def mind = lists.collect { rate, pair -> def f = file("${workDir}/stratum.rung" + rate + ".mind_remove.txt"); f.text = pair[1].join('\\n') + '\\n'; f }
                input[0] = [ [ id:'stratum' ], snplist, fam, [90, 91, 92], geno, mind ]
                """
            }
        }

        then {
            def ladder = path(process.out.ladder.get(0).get(1)).readLines().collect { line -> line.split('\t').toList() }
            assertAll(
                { assert process.success },
                { assert ladder[0] == ['step', 'call_rate', 'filter', 'missing_threshold', 'variants_removed', 'variants_remaining', 'samples_removed', 'samples_remaining'] },
                // The legacy Iterative_Missingness table: a variant and a sample step per rung, each applied to
                // what the step before it left.
                { assert ladder.drop(1) == [
                    ['90', '90', 'geno', '0.1', '1', '9', '0', '5'],
                    ['90/90', '90', 'mind', '0.1', '0', '9', '1', '4'],
                    ['90/91', '91', 'geno', '0.09', '1', '8', '0', '4'],
                    ['91/91', '91', 'mind', '0.09', '0', '8', '0', '4'],
                    ['91/92', '92', 'geno', '0.08', '0', '8', '0', '4'],
                    ['92/92', '92', 'mind', '0.08', '0', '8', '1', '3'],
                ] },
                { assert snapshot(process.out).match() },
            )
        }
    }

    test("synthetic - stub") {

        options "-stub"

        when {
            process {
                """
                def snplist = file("${workDir}/stratum.maf.snplist")
                snplist.text = 'v1\\n'
                def fam = file("${workDir}/stratum.fam")
                fam.text = 's1 s1 0 0 1 -9\\n'
                def geno = file("${workDir}/stratum.rung90.geno_exclude.txt")
                geno.text = ''
                def mind = file("${workDir}/stratum.rung90.mind_remove.txt")
                mind.text = ''
                input[0] = [ [ id:'stratum' ], snplist, fam, [90], [geno], [mind] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.ladder.get(0).get(1)).readLines() == ['step\tcall_rate\tfilter\tmissing_threshold\tvariants_removed\tvariants_remaining\tsamples_removed\tsamples_remaining'] },
                { assert snapshot(sanitizeOutput(process.out)).match() },
            )
        }
    }
}
