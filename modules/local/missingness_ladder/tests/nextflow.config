process {
    // The pipeline's per-family configs are loaded from the project root and their bare selectors match here
    // too. The module contract is tested under its own defaults, so prefix and publication are pinned back;
    // the two per-rung setup runs take distinct prefixes because their reports are staged side by side.
    withName: 'PLINK2_MISSING|MISSINGNESS_LADDER' {
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_MISSING_RUNG90' {
        ext.prefix = { "${meta.id}.ladder90" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_MISSING_RUNG99' {
        ext.prefix = { "${meta.id}.ladder99" }
        publishDir = [enabled: false]
    }
}
