process {
    // The pipeline's per-family configs are loaded from the project root and their bare selectors match here
    // too, including the setup process. The module contract is tested under its own defaults, so prefix and
    // publication are pinned back.
    withName: 'PLINK2_MISSING|GENO_DECISIONS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
