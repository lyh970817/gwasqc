nextflow_process {

    name "Test Process MISSINGNESS_DECISIONS"
    script "../main.nf"
    process "MISSINGNESS_DECISIONS"

    tag "modules"
    tag "modules_local"
    tag "missingness_decisions"

    // The public plink_simulated fixture carries no missing call, so the decisions are exercised on the
    // gwasqc fixture stratum, whose planted defects the README documents: samples EUR_S040 and EUR_S041 at
    // F_MISS 0.15 and 0.22, EUR_S042 at 0.05, twenty chr3 variants above 0.10 and five chr4 variants near 0.05.
    setup {
        run("PLINK2_MISSING") {
            script "../../plink2/missing/main.nf"
            process {
                """
                input[0] = [
                    [ id:'study_eur', ancestry:'EUR' ],
                    file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bed', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bim', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.fam', checkIfExists: true),
                    [],
                    [],
                    [],
                    [],
                ]
                """
            }
        }
    }

    test("study_eur - geno 0.10 mind 0.10") {

        when {
            process {
                """
                input[0] = PLINK2_MISSING.out.vmiss.join(PLINK2_MISSING.out.smiss)
                input[1] = 0.10
                input[2] = 0.10
                """
            }
        }

        then {
            def ladder = path(process.out.ladder.get(0).get(1)).readLines().collect { line -> line.split('\t').toList() }
            assertAll(
                { assert process.success },
                { assert path(process.out.variant_exclude.get(0).get(1)).readLines().size() == 20 },
                { assert path(process.out.sample_remove.get(0).get(1)).readLines() == ['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041'] },
                { assert ladder.size() == 21 },
                { assert ladder[0] == ['step', 'sample_snp', 'sample_call_rate', 'variant_call_rate', 'variants', 'participants', 'variants_remaining', 'samples_remaining'] },
                // Rung 1 is the geno step at 90 %, rung 2 the mind step at 90 %; labels follow the legacy table.
                { assert ladder[1][1..5] == ['90', 'NA', '90', '20', '0'] },
                { assert ladder[2][1..5] == ['90/90', '90', '90', '0', '2'] },
                { assert ladder[3][1] == '90/91' },
                { assert ladder[20][1] == '99/99' },
                { assert snapshot(process.out.variant_exclude, process.out.sample_remove, process.out.ladder, process.out.versions).match() },
            )
        }
    }

    test("study_eur - geno 0.02 mind 0.02") {

        when {
            process {
                """
                input[0] = PLINK2_MISSING.out.vmiss.join(PLINK2_MISSING.out.smiss)
                input[1] = 0.02
                input[2] = 0.02
                """
            }
        }

        then {
            def variant_exclude = path(process.out.variant_exclude.get(0).get(1)).readLines()
            def sample_remove = path(process.out.sample_remove.get(0).get(1)).readLines()
            assertAll(
                { assert process.success },
                // The borderline variants and sample fall at the stricter threshold.
                { assert variant_exclude.containsAll(['rs1498627', 'rs1499588', 'rs1500478', 'rs1501405', 'rs1502040']) },
                { assert sample_remove.containsAll(['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041', 'EUR_S042 EUR_S042']) },
                { assert snapshot(process.out.variant_exclude, process.out.sample_remove).match() },
            )
        }
    }

    test("study_eur - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = PLINK2_MISSING.out.vmiss.join(PLINK2_MISSING.out.smiss)
                input[1] = 0.05
                input[2] = 0.05
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() },
            )
        }
    }
}
