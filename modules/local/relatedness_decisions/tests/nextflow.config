process {
    // The pipeline's per-family configs are loaded from the project root and their bare selectors match here
    // too. The module contract is tested under its own defaults, so prefix and publication are pinned back; the
    // setup kinship table is restricted to pairs above the third-degree bound and carries the matrix of every
    // pair, as the pipeline configures it, and the unfiltered alias writes every pair as a table.
    withName: 'PLINK2_MAKEKINGTABLE' {
        ext.args   = '--king-table-filter 0.0442 --make-king triangle bin4'
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_MAKEKINGTABLE_ALL|PLINK2_MISSING|RELATEDNESS_DECISIONS' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
