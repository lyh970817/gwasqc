params {
    module_args2 = ''
}

process {
    // The pipeline's per-family configs are loaded from the project root and their bare selectors match here
    // too, including the setup process. The module contract is tested under its own defaults, so args, prefix
    // and publication are pinned back; the `--pca` modifiers vary per scenario.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args   = '--maf 0.3'
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_PCAWTS' {
        ext.args   = ''
        ext.args2  = params.module_args2
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
