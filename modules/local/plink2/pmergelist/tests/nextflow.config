process {
    // The pipeline's per-family configs are loaded from the project root and their bare selectors match here
    // too, including the setup processes. The module contract is tested under its own defaults, so args,
    // prefix and publication are pinned back; the two setup filesets are chromosome halves of the fixture
    // reference, standing in for a per-chromosome panel.
    withName: 'PLINK2_MAKEBED_FIRST' {
        ext.args   = '--chr 1-11'
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_MAKEBED_SECOND' {
        ext.args   = '--chr 12-22'
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args   = '--maf 0.3'
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_PMERGELIST' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
