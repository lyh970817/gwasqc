process {
    // The pipeline's `conf/modules/plink2.config` is loaded from the project root and its bare selectors match
    // here too, including the setup process. The module contract is tested under its own defaults, so args,
    // prefix and publication are pinned back.
    withName: 'PLINK2_WRITESNPLIST|PLINK2_MISSING' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
