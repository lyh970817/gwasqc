process {
    // The pipeline's `conf/modules/plink2.config` is loaded from the project root and its bare selectors match
    // here too. The module contract is tested under its own defaults, so args and prefix are pinned back.
    withName: 'PLINK2_HARDY' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
    }
}
