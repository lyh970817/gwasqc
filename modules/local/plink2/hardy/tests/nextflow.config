// The optional arguments default to empty and are set only by the scenario that needs them.
params {
    module_args  = ''
    module_args2 = ''
}

process {
    // The pipeline's `conf/modules/plink2.config` is loaded from the project root and its bare selectors match
    // here too. The module contract is tested under its own defaults, so args, prefix and publication are
    // pinned back; a scenario that needs a `--hardy` modifier sets `params.module_args2`.
    withName: 'PLINK2_HARDY' {
        ext.args   = { params.module_args }
        ext.args2  = { params.module_args2 }
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
