// The optional arguments default to empty and are set only by the scenario that needs them.
params {
    module_args = ''
}

process {
    // The pipeline's `conf/modules/plink2.config` is loaded from the project root and its bare selectors match
    // here too, including the setup process. The module contract is tested under its own defaults, so prefix
    // and publication are pinned back.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_MAKEKINGTABLE' {
        ext.args   = { params.module_args }
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
