params {
    module_args = ''
}

process {
    // The pipeline's `conf/modules/plink2.config` is loaded from the project root and its bare selectors match
    // here too. The module contract is tested under its own defaults, so args, prefix and publication are
    // pinned back.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args   = params.module_args
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
