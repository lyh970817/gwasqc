process {
    // The pipeline's per-family configs are loaded from the project root and their bare selectors match here
    // too. The module contract is tested under its own defaults, so prefix and publication are pinned back; the
    // setup sex check runs with the PAR split and the pipeline's thresholds so that the report carries F. The
    // reference alias is pinned back too, because the pipeline config gives it its own prefix.
    withName: 'PLINK2_HET|PLINK2_HET_REFERENCE' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'PLINK2_CHECKSEX' {
        ext.args   = '--split-par b38'
        ext.args2  = 'max-female-xf=0.2 min-male-xf=0.8 max-female-ycount=0 min-male-ycount=1 cols=+ycount'
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
    withName: 'HETEROZYGOSITY_PLOTS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }
}
