/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PLINK 2 module options
----------------------------------------------------------------------------------------
*/

// PLINK 2 STATISTICS AND MATERIALISATION
//
// Every plink2 process of the QC chain runs on the unfiltered stratum fileset and receives the accumulated
// filter lists as inputs; only the terminal `--make-bed` writes a fileset. Published: that fileset and the
// statistics tables that no published table contains already. The pruned-out list (the QC'd set minus the
// pruned-in list), the KING table (the classified pairs table carries every column of it) and the score
// projections (the ancestry plot-data table carries every coordinate) stay in the work directory with the run
// logs. A threshold reaches a plink2 process only as native optional behaviour through ext.args, never as a
// module input.

process {

    withName: 'PLINK2_WRITESNPLIST' {
        ext.args   = { "--maf ${params.maf}" }
        ext.prefix = { "${meta.id}.maf" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/maf" },
            mode: params.publish_dir_mode,
            pattern: '*.snplist',
        ]
    }

    withName: 'PLINK2_MISSING_VARIANTS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.vmiss',
        ]
    }

    withName: 'PLINK2_MISSING_SAMPLES' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.smiss',
        ]
    }

    withName: 'PLINK2_MISSING_LADDER' {
        // One run per rung of the call-rate ladder; the rung keeps the reports of a stratum apart when they
        // are gathered. Nothing is published: the ladder table is the product.
        ext.prefix = { "${meta.id}.ladder${meta.call_rate}" }
    }

    withName: 'PLINK2_HARDY' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/hwe" },
            mode: params.publish_dir_mode,
            pattern: '*.hardy*',
        ]
    }

    withName: 'PLINK2_INDEPPAIRWISE' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ld_pruning" },
            mode: params.publish_dir_mode,
            pattern: '*.prune.in',
        ]
    }

    withName: 'PLINK2_CHECKSEX' {
        // The pseudo-autosomal regions are split off in the same run, before the check; the thresholds are
        // modifiers of --check-sex and travel in the second segment, with the chromosome Y call count added
        // to the report for the mismatch table.
        ext.args   = { "--split-par ${params.genome_build}" }
        ext.args2  = {
            [
                "max-female-xf=${params.sex_check_max_female_xf}",
                "min-male-xf=${params.sex_check_min_male_xf}",
                "max-female-ycount=${params.sex_check_max_female_ycount}",
                "min-male-ycount=${params.sex_check_min_male_ycount}",
                'cols=+ycount',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/sex_check" },
            mode: params.publish_dir_mode,
            pattern: '*.sexcheck',
        ]
    }

    withName: 'PLINK2_HET' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/heterozygosity" },
            mode: params.publish_dir_mode,
            pattern: '*.het',
        ]
    }

    withName: 'PLINK2_MAKEKINGTABLE' {
        ext.args   = { "--king-table-filter ${params.king_table_filter}" }
    }

    withName: 'PLINK2_MAKEBED' {
        ext.prefix = { "${meta.id}.qc" }
        publishDir = [
            path: { "${params.outdir}/genotypes/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{bed,bim,fam}',
        ]
    }

    // ANCESTRY REFERENCE
    //
    // The reference panel is materialised twice per stratum, and only the reference: once per fileset
    // restricted to the stratum's QC'd variants and once merged onto the stratum's strand. Neither is
    // published; the pruned list, the eigenvalues and the projections are. A selector also matches the
    // aliases of its base process, so the publication and prefix of the base processes above are overridden
    // here.

    withName: 'PLINK2_MAKEBED_REFERENCE' {
        // The reference-side variant filters of the legacy intersect, minus its Hardy-Weinberg test: on a
        // panel that pools several populations that test measures population structure, and would remove
        // exactly the variants that separate the groups.
        ext.args   = { "--maf ${params.maf} --geno ${params.geno}" }
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }

    withName: 'PLINK2_PMERGELIST' {
        ext.prefix = { "${meta.id}.ancestry_reference" }
    }

    withName: 'PLINK2_INDEPPAIRWISE_REFERENCE' {
        ext.prefix = { "${meta.id}.ancestry" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.prune.in',
        ]
    }

    withName: 'PLINK2_PCAWTS' {
        // The documented projection layout of the weight file: ID in column 2, the weighted allele in column
        // 5 and the weights from column 6, which the score runs below address.
        ext.args2  = 'vcols=chrom,ref,alt'
        ext.prefix = { "${meta.id}.ancestry" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.eigenval',
        ]
    }

    withName: 'PLINK2_SCORE_REFERENCE|PLINK2_SCORE_STUDY' {
        // The documented projection recipe: the reference allele counts standardise every sample alike, a
        // missing genotype is left out rather than imputed, and the scored variants are listed so that the
        // projection can be checked against the pruned set.
        ext.args   = { "--score-col-nums 6-${5 + params.ancestry_n_pcs}" }
        ext.args2  = '2 5 header-read no-mean-imputation variance-standardize list-variants'
    }

    withName: 'PLINK2_SCORE_REFERENCE' {
        ext.prefix = { "${meta.id}.ancestry_reference" }
    }

    withName: 'PLINK2_SCORE_STUDY' {
        ext.prefix = { "${meta.id}.ancestry_study" }
    }
}
