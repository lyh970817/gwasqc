/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PLINK 2 module options
----------------------------------------------------------------------------------------
*/

// PLINK 2 STATISTICS AND MATERIALISATION
//
// Every plink2 process of the QC chain runs on the unfiltered stratum fileset and receives the accumulated
// filter lists as inputs; only the terminal `--make-bed` writes a fileset. Published: that fileset and the
// statistics tables that no published table contains already. The pruned-out list (the QC'd set minus the
// pruned-in list), the KING table (the classified pairs table carries every column of it) and the score
// projections (the ancestry plot-data table carries every coordinate) stay in the work directory with the run
// logs. A threshold reaches a plink2 process only as native optional behaviour through ext.args, never as a
// module input.

process {

    withName: 'PLINK2_WRITESNPLIST' {
        ext.args   = { "--maf ${params.maf}" }
        ext.prefix = { "${meta.id}.maf" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/maf" },
            mode: params.publish_dir_mode,
            pattern: '*.snplist',
        ]
    }

    withName: 'PLINK2_MISSING_VARIANTS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.vmiss',
        ]
    }

    withName: 'PLINK2_MISSING_SAMPLES' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.smiss',
        ]
    }

    withName: 'PLINK2_MISSING_LADDER' {
        // One run per rung of the call-rate ladder; the rung keeps the reports of a stratum apart when they
        // are gathered. Unpublished by the process-wide default: the ladder table is the product, and no
        // selector publishes the base process PLINK2_MISSING (only its two aliases above), so nothing reaches
        // this alias and no explicit `enabled: false` is needed.
        ext.prefix = { "${meta.id}.ladder${meta.call_rate}" }
    }

    withName: 'PLINK2_HARDY' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/hwe" },
            mode: params.publish_dir_mode,
            pattern: '*.hardy*',
        ]
    }

    withName: 'PLINK2_INDEPPAIRWISE' {
        // plink2 refuses `--indep-pairwise` below 50 samples, where pairwise r-squared is unreliable. A
        // stratum reaches this process only in the study marker-set mode, by the user's choice or threshold,
        // so the refusal is lifted and the summary row notes a collapsed pruning instead (verified on
        // 2.0.0a.6.9: 12 samples are refused without `--bad-ld` and keep 4.8 % of their variants with it).
        ext.args   = '--bad-ld'
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ld_pruning" },
            mode: params.publish_dir_mode,
            pattern: '*.prune.in',
        ]
    }

    withName: 'PLINK2_CHECKSEX' {
        // The pseudo-autosomal regions are split off in the same run, before the check; the thresholds are
        // modifiers of --check-sex and travel in the second segment, with the chromosome Y call count added
        // to the report for the mismatch table.
        // The chromosome X frequencies of the check come from the stratum itself in both marker-set modes,
        // because the reference carries no chromosome X, and plink2 refuses `--check-sex` below 50 samples
        // unless those frequencies are accepted as unreliable, which is the deliberate choice of the shared
        // mode (verified on 2.0.0a.6.9: 12 samples are refused without `--bad-freqs`, and give the same
        // verdicts with it as with `--read-freq` of the stratum's own `--freq`).
        ext.args   = { ["--split-par ${params.genome_build}", '--bad-freqs'].join(' ').trim() }
        ext.args2  = {
            [
                "max-female-xf=${params.sex_check_max_female_xf}",
                "min-male-xf=${params.sex_check_min_male_xf}",
                "max-female-ycount=${params.sex_check_max_female_ycount}",
                "min-male-ycount=${params.sex_check_min_male_ycount}",
                'cols=+ycount',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/sex_check" },
            mode: params.publish_dir_mode,
            pattern: '*.sexcheck',
        ]
    }

    withName: 'PLINK2_HET' {
        // In study mode the expected homozygosity is computed from the stratum's own frequencies, which plink2
        // refuses to use below 50 samples unless told to; in shared mode the matched reference frequencies
        // arrive through `--read-freq`, cover every extracted marker and lift the refusal on their own, so no
        // such acceptance is given there.
        ext.args   = { meta.sample_qc_marker_set == 'study' ? '--bad-freqs' : '' }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/heterozygosity" },
            mode: params.publish_dir_mode,
            pattern: '*.het',
        ]
    }

    // SHARED MARKER SET
    //
    // For a stratum in shared mode the heterozygosity baseline is the reference samples of its own
    // super-population over the reference-pruned markers: their allele frequencies, read by both --het runs
    // through --read-freq, and their own report. Both are published beside the study's report, under the
    // reference token, so that a reviewer can see what the study's F was standardised against.

    withName: 'PLINK2_FREQ' {
        ext.prefix = { "${meta.id}.reference" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/heterozygosity" },
            mode: params.publish_dir_mode,
            pattern: '*.afreq',
        ]
    }

    withName: 'PLINK2_HET_REFERENCE' {
        // An alias of the published PLINK2_HET, whose selector above already publishes its report into the
        // same stage directory; the publication is restated here with the prefix that keeps the two apart,
        // and the study-mode acceptance of unreliable frequencies is withdrawn: the reference reads the
        // matched frequencies through `--read-freq`.
        ext.args   = ''
        ext.prefix = { "${meta.id}.reference" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/heterozygosity" },
            mode: params.publish_dir_mode,
            pattern: '*.het',
        ]
    }

    withName: 'PLINK2_MAKEKINGTABLE' {
        // Unpublished by the process-wide default: no selector publishes this process, and the classified
        // pairs table carries every column of the kinship report.
        ext.args   = { "--king-table-filter ${params.king_table_filter}" }
    }

    withName: 'PLINK2_MAKEBED' {
        ext.prefix = { "${meta.id}.qc" }
        publishDir = [
            path: { "${params.outdir}/genotypes/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{bed,bim,fam}',
        ]
    }

    // ANCESTRY REFERENCE
    //
    // The reference panel is materialised twice per stratum, and only the reference: once per fileset
    // restricted to the variants harmonised with the stratum, and once merged, renamed to the stratum's IDs
    // and flipped onto its strand. Neither is published; the pruned lists, the eigenvalues and the
    // projections are. The reference-side variant filters of the legacy intersect, `--maf` and `--geno`
    // without its Hardy-Weinberg test, run on the pruning runs rather than on the intersect, so that the
    // shared marker set can be filtered on the ancestry-matched reference samples alone: plink2 computes both
    // over the `--keep` subset and applies them before `--indep-pairwise` (verified on 2.0.0a.6.9). On a
    // panel that pools several populations a Hardy-Weinberg test measures population structure, and would
    // remove exactly the variants that separate the groups. A selector also matches the aliases of its base
    // process, so the publication, prefix and arguments of the base processes above are overridden here.

    withName: 'PLINK2_MAKEBED_REFERENCE' {
        // Deliberately unpublished as an alias of the published PLINK2_MAKEBED, whose selector above would
        // otherwise reach it, so publication is switched off explicitly.
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }

    withName: 'PLINK2_PMERGELIST' {
        // Unpublished by the process-wide default: no selector publishes this process, so the merged reference
        // fileset stays in the work directory without an explicit `enabled: false`.
        ext.prefix = { "${meta.id}.ancestry_reference" }
    }

    withName: 'PLINK2_INDEPPAIRWISE_REFERENCE' {
        // The pooled panel's filters precede its pruning in the same run. The study-side `--bad-ld` of the
        // base selector is withdrawn: a reference panel below plink2's LD sample floor is a genuine error, not
        // a mode the pipeline chose.
        ext.args   = { "--maf ${params.maf} --geno ${params.geno}" }
        ext.prefix = { "${meta.id}.ancestry" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.prune.in',
        ]
    }

    withName: 'PLINK2_INDEPPAIRWISE_MATCHED' {
        // The shared marker set under `--sample_qc_shared_reference matched`: the same filters and pruning on
        // the reference samples of the stratum's super-population alone. The study-side `--bad-ld` and
        // publication of the base selector are overridden: fewer than plink2's 50 matched reference samples is
        // a panel that cannot carry this choice, and the list is published beside the pooled one.
        ext.args   = { "--maf ${params.maf} --geno ${params.geno}" }
        ext.prefix = { "${meta.id}.ancestry_matched" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.prune.in',
        ]
    }

    withName: 'PLINK2_PCAWTS' {
        // The documented projection layout of the weight file: ID in column 2, the weighted allele in column
        // 5 and the weights from column 6, which the score runs below address.
        ext.args2  = 'vcols=chrom,ref,alt'
        ext.prefix = { "${meta.id}.ancestry" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.eigenval',
        ]
    }

    withName: 'PLINK2_SCORE_REFERENCE|PLINK2_SCORE_STUDY' {
        // The documented projection recipe: the reference allele counts standardise every sample alike, a
        // missing genotype is left out rather than imputed, and the scored variants are listed so that the
        // projection can be checked against the pruned set. Unpublished by the process-wide default: no
        // selector publishes PLINK2_SCORE or either alias, and the ancestry plot-data table carries every
        // projected coordinate.
        ext.args   = { "--score-col-nums 6-${5 + params.ancestry_n_pcs}" }
        ext.args2  = '2 5 header-read no-mean-imputation variance-standardize list-variants'
    }

    withName: 'PLINK2_SCORE_REFERENCE' {
        ext.prefix = { "${meta.id}.ancestry_reference" }
    }

    withName: 'PLINK2_SCORE_STUDY' {
        ext.prefix = { "${meta.id}.ancestry_study" }
    }
}
