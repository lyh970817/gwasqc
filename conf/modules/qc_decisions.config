/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QC decision module options
----------------------------------------------------------------------------------------
*/

// QC DECISIONS
//
// The R decision modules turn plink2 statistics into the decision lists the terminal materialisation applies.
// Published: every decision list and the call-rate ladder, beside the statistics they were derived from.

process {

    withName: 'GENO_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'GENO_DECISIONS_LADDER' {
        // One list per rung of the call-rate ladder, consumed by the per-rung sample report only. A selector
        // also matches the aliases of its base process, so the GENO_DECISIONS publication above reaches this
        // alias and is switched off again here.
        ext.prefix = { "${meta.id}.ladder${meta.call_rate}" }
        publishDir = [enabled: false]
    }

    withName: 'MIND_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'MISSINGNESS_LADDER' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv',
        ]
    }

    withName: 'HWE_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/hwe" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

}
