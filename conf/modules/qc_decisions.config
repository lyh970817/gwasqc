/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QC decision module options
----------------------------------------------------------------------------------------
*/

// QC DECISIONS
//
// The R decision modules turn plink2 statistics into the decision lists the terminal materialisation applies.
// Published: every decision list and the call-rate ladder, beside the statistics they were derived from.

process {

    withName: 'MISSINGNESS_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.{txt,tsv}',
        ]
    }

    withName: 'HWE_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/hwe" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }
}
