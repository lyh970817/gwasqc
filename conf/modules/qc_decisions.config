/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    QC decision and plot module options
----------------------------------------------------------------------------------------
*/

// QC DECISIONS AND PLOTS
//
// The R and gawk decision modules turn plink2 statistics into the decision lists the terminal materialisation
// applies, and the R plot modules draw the review figures. Published: every decision list, the call-rate
// ladder, the classified tables, the plots and their plot-data tables, beside the statistics they were derived
// from.

process {

    withName: 'GENO_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'GENO_DECISIONS_LADDER' {
        // One list per rung of the call-rate ladder, consumed by the per-rung sample report only. A selector
        // also matches the aliases of its base process, so the GENO_DECISIONS publication above reaches this
        // alias and is switched off again here.
        ext.prefix = { "${meta.id}.ladder${meta.call_rate}" }
        publishDir = [enabled: false]
    }

    withName: 'MIND_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'MISSINGNESS_LADDER' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv',
        ]
    }

    withName: 'MISSINGNESS_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/missingness" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,pdf,png}',
        ]
    }

    withName: 'HWE_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/hwe" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'HWE_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/hwe" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,pdf,png}',
        ]
    }

    withName: 'HIGHLD_EXCLUDE' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ld_pruning" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'SEX_CHECK_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/sex_check" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt,pdf,png}',
        ]
    }

    withName: 'HETEROZYGOSITY_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/heterozygosity" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,pdf,png}',
        ]
    }

    withName: 'RELATEDNESS_DECISIONS' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/relatedness" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt,pdf,png}',
        ]
    }

    // ANCESTRY
    //
    // The harmonisation lists and tables, the assignment, its lists and the projection plots, beside the
    // reference projections. A selector also matches the aliases of its base process, so the long-range LD
    // exclusion of the reference is re-pointed here.

    withName: 'HIGHLD_EXCLUDE_REFERENCE' {
        ext.prefix = { "${meta.id}.ancestry" }
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.txt',
        ]
    }

    withName: 'ANCESTRY_HARMONISE' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.{snplist,txt,tsv}',
        ]
    }

    withName: 'ANCESTRY_ASSIGN' {
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/ancestry" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt,keep,pdf,png}',
        ]
    }
}
