/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Alt-contig test profile options

    Use as follows:
        nextflow run nf-core/gwasqc -profile test_alt_contig,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

// The minimal test profile, its resource ceiling and its fixture base, with the cohort and the panel replaced:
// the fixture's EUR stratum beside a copy of it that also carries variants on alt and random contigs, and a
// copy of the reference panel that carries the same contig variants. Both samplesheets are written against
// the fixture base the shared resolver chose, as that resolver writes the reference samplesheet, so the
// scenario reads the same fixture source as the test profile.
includeConfig 'test.config'

params {
    config_profile_name        = 'Alt-contig test profile'
    config_profile_description = 'The EUR stratum of the synthetic fixture beside a copy carrying alt and random contig variants, against a reference panel carrying the same'

    input                      = {
        def base = "${params.pipelines_testdata_base_path}data/gwasqc/"
        def content = [
            'id,ancestry,bed,bim,fam',
            "study_eur,EUR,${base}genotypes/study_eur.bed,${base}genotypes/study_eur.bim,${base}genotypes/study_eur.fam",
            "study_eur_alt,EUR,${base}alt_contig/study_eur_alt.bed,${base}alt_contig/study_eur_alt.bim,${base}alt_contig/study_eur_alt.fam",
        ].join('\n') + '\n'
        def digest = java.security.MessageDigest.getInstance('SHA-256').digest(content.bytes).encodeHex().toString()
        def target = new File(System.getProperty('java.io.tmpdir'), "nf-core-gwasqc/samplesheet-${digest.take(16)}.csv")
        target.parentFile.mkdirs()
        target.text = content
        target.absolutePath
    }.call()

    reference_panel            = {
        def base = "${params.pipelines_testdata_base_path}data/gwasqc/"
        def content = "id,bed,bim,fam\nref_panel_alt,${base}alt_contig/ref_panel_alt.bed,${base}alt_contig/ref_panel_alt.bim,${base}alt_contig/ref_panel_alt.fam\n"
        def digest = java.security.MessageDigest.getInstance('SHA-256').digest(content.bytes).encodeHex().toString()
        def target = new File(System.getProperty('java.io.tmpdir'), "nf-core-gwasqc/reference_panel-${digest.take(16)}.csv")
        target.parentFile.mkdirs()
        target.text = content
        target.absolutePath
    }.call()
}
