/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test profile options

    Use as follows:
        nextflow run nf-core/gwasqc -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

// The suite runs on GitHub-hosted runners, which offer about 8 GB of RAM, so the memory ceiling is
// lower than the nf-core template's 15 GB; the fixtures are small enough that no stage needs more.
process {
    resourceLimits = [cpus: 4, memory: '6.GB', time: '1.h']
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic two-stratum fixture with planted defects to check pipeline function'
}

// Input data: the fixture samplesheet, resolved against the fixture base
includeConfig 'test_fixtures.config'
