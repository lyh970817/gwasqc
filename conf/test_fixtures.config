/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwasqc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Fixture samplesheet resolver shared by the test profiles
----------------------------------------------------------------------------------------
*/

// The gwasqc fixture samplesheet (`data/gwasqc/samplesheet.csv` on the `gwasqc` branch of nf-core/test-datasets)
// declares its filesets relative to `data/gwasqc/`, so that one fixture tree serves both the published branch
// and a local checkout. nf-schema resolves a relative samplesheet path against the launch directory only, so
// the test profiles resolve the rows against the fixture base here, before validation, and point `--input`
// at the resolved copy.
//
// The base is `params.pipelines_testdata_base_path`: a URL or a local directory, with or without a trailing
// slash. GWASQC_TEST_FIXTURES, when set, names a local checkout of the fixture branch and takes precedence. It
// is read here rather than in `tests/nextflow.config` because a value set through `-c` is not visible to a
// profile expression, while an environment variable and a `--pipelines_testdata_base_path` argument are.
params {
    pipelines_testdata_base_path = {
        def declared = System.getenv('GWASQC_TEST_FIXTURES') ?: params.pipelines_testdata_base_path
        declared.endsWith('/') ? declared : "${declared}/"
    }.call()

    input                        = {
        def base = params.pipelines_testdata_base_path
        def samplesheet = "${base}data/gwasqc/samplesheet.csv"
        def is_remote = base.startsWith('http://') || base.startsWith('https://')

        // Module tests run under this profile too and never read the samplesheet, so an absent fixture is
        // reported once and left for nf-schema to reject when a pipeline run does need it.
        def available
        if (is_remote) {
            def connection = new URL(samplesheet).openConnection()
            connection.requestMethod = 'HEAD'
            available = connection.responseCode == 200
        }
        else {
            available = new File(samplesheet).isFile()
        }
        if (!available) {
            System.err.println("[nf-core/gwasqc]: the test profile could not find the fixture samplesheet ${samplesheet}; set GWASQC_TEST_FIXTURES to a local checkout of the gwasqc branch of nf-core/test-datasets, or pass --pipelines_testdata_base_path")
            return samplesheet
        }

        def lines = (is_remote ? new URL(samplesheet).text : new File(samplesheet).text).readLines().findAll { line -> line.trim() }
        def header = lines[0].split(',').toList()
        def path_columns = ['bed', 'bim', 'fam'].collect { column -> header.indexOf(column) }
        def resolved = [lines[0]] + lines.drop(1).collect { line ->
            def fields = line.split(',', -1)
            path_columns.each { index ->
                def value = fields[index]
                if (value && !value.startsWith('/') && !value.contains('://')) {
                    fields[index] = "${base}data/gwasqc/${value}"
                }
            }
            fields.join(',')
        }
        def content = resolved.join('\n') + '\n'
        def digest = java.security.MessageDigest.getInstance('SHA-256').digest(content.bytes).encodeHex().toString()
        def target = new File(System.getProperty('java.io.tmpdir'), "nf-core-gwasqc/samplesheet-${digest.take(16)}.csv")
        target.parentFile.mkdirs()
        target.text = content
        target.absolutePath
    }.call()
}
