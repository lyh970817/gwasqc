nextflow_workflow {

    name "Test Workflow PLINK_QC_FILTER_LISTS"
    script "../main.nf"
    workflow "PLINK_QC_FILTER_LISTS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "contig_exclude"
    tag "plink2/writesnplist"
    tag "plink2/missing"
    tag "geno_decisions"
    tag "mind_decisions"
    tag "missingness_ladder"
    tag "missingness_plots"
    tag "plink2/hardy"
    tag "hwe_decisions"
    tag "hwe_plots"
    tag "subworkflows/missingness_rung"
    tag "subworkflows/plink_qc_filter_lists"

    test("gwasqc fixtures - two strata") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'study_eur', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.fam', checkIfExists: true),
                    ],
                    [
                        [ id:'study_afr', ancestry:'AFR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_afr.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_afr.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_afr.fam', checkIfExists: true),
                    ]
                )
                input[1] = 0.05
                input[2] = 0.05
                input[3] = 1e-10
                input[4] = 'iterative'
                """
            }
        }

        then {
            def by_id = { emission -> emission.collectEntries { entry -> [(entry[0].id): path(entry[1])] } }
            def maf_snplist = by_id(workflow.out.maf_snplist)
            def geno_exclude = by_id(workflow.out.geno_exclude)
            def smiss = by_id(workflow.out.smiss)
            def smiss_maf = by_id(workflow.out.smiss_maf)
            def hwe_exclude = by_id(workflow.out.hwe_exclude)
            def mind_remove = by_id(workflow.out.mind_remove)
            def ladder = by_id(workflow.out.missingness_ladder)
            def obs_ct = { report -> report.readLines().drop(1).collect { line -> line.split('\t')[3] as Integer }.max() }
            assertAll(
                { assert workflow.success },
                { assert workflow.out.maf_snplist.collect { entry -> entry[0].id }.sort() == ['study_afr', 'study_eur'] },
                { assert workflow.out.hardy_x.collect { entry -> entry[0].id }.sort() == ['study_afr', 'study_eur'] },
                // Every emission keeps the incoming metadata, ancestry included, and the ladder rung never leaks.
                { assert workflow.out.hwe_exclude.collect { entry -> entry[0] }.sort { entry -> entry.id } == [[id: 'study_afr', ancestry: 'AFR'], [id: 'study_eur', ancestry: 'EUR']] },
                { assert workflow.out.missingness_ladder.collect { entry -> entry[0] }.sort { entry -> entry.id } == [[id: 'study_afr', ancestry: 'AFR'], [id: 'study_eur', ancestry: 'EUR']] },
                // Planted defects from the fixture README. MAF drops eight EUR and nine AFR variants over all
                // chromosomes, and both strata carry the same five gross HWE violations. The cumulative ladder up
                // to call rate 95 first drops the twenty planted chr3 variants and the two high-missingness
                // samples at rung 90, then the borderline chr4 variants that exceed a rung's threshold among the
                // samples left: 23 variants in EUR and 22 in AFR, as plink2 --geno then --mind, rung by rung on
                // the fileset each step leaves, also drops them.
                { assert maf_snplist.study_eur.readLines().size() == 3954 },
                { assert maf_snplist.study_afr.readLines().size() == 3953 },
                { assert geno_exclude.study_eur.readLines().size() == 23 },
                { assert geno_exclude.study_afr.readLines().size() == 22 },
                { assert geno_exclude.study_eur.readLines().containsAll(['rs1395803', 'rs1406332']) },
                { assert hwe_exclude.study_eur.readLines() == ['rs1667531', 'rs1668208', 'rs1668410', 'rs1668428', 'rs1668730'] },
                { assert hwe_exclude.study_afr.readLines() == ['rs1667531', 'rs1668208', 'rs1668410', 'rs1668428', 'rs1668730'] },
                // The two high-missingness samples fall in both strata, at rung 90; the borderline sample, F_MISS
                // 0.05 or just under it, survives every rung up to 95.
                { assert mind_remove.study_eur.readLines() == ['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041'] },
                { assert mind_remove.study_afr.readLines() == ['AFR_S040 AFR_S040', 'AFR_S041 AFR_S041'] },
                // The applied sample report is rung 95's, measured over the variants that rung keeps.
                { assert obs_ct(smiss.study_eur) == 3954 - 23 },
                // The duplicate rule's report is the legacy `_maf<maf>_check.imiss`, measured over every
                // MAF-passing variant and every sample before any geno filter, whichever rung is applied: its largest
                // OBS_CT is the MAF-passing count, it still lists the samples the ladder removes, and the borderline
                // sample sits at its 0.0501 there while the applied report keeps it at or under the threshold.
                { assert obs_ct(smiss_maf.study_eur) == 3954 },
                { assert obs_ct(smiss_maf.study_afr) == 3953 },
                { assert smiss_maf.study_eur.readLines().size() == 126 },
                { assert smiss_maf.study_eur.readLines().find { line -> line.split('\t')[1] == 'EUR_S042' }.split('\t')[4] as Double > 0.05 },
                { assert smiss.study_eur.readLines().find { line -> line.split('\t')[1] == 'EUR_S042' }.split('\t')[4] as Double <= 0.05 },
                // Two ladder rows per call rate, 90 to 99, labelled as the legacy log was: the variant step of
                // each rung names the previous rung's sample call rate.
                { assert ladder.study_eur.readLines().size() == 21 },
                { assert ladder.study_eur.readLines()[0].split('\t').toList() == ['step', 'call_rate', 'filter', 'missing_threshold', 'variants_removed', 'variants_remaining', 'samples_removed', 'samples_remaining'] },
                { assert ladder.study_eur.readLines().drop(1).collect { line -> line.split('\t')[0] } == ['90', '90/90'] + (91..99).collectMany { rate -> ["${rate - 1}/${rate}".toString(), "${rate}/${rate}".toString()] } },
                { assert ladder.study_eur.readLines()[1].split('\t').toList() == ['90', '90', 'geno', '0.1', '20', '3934', '0', '125'] },
                { assert ladder.study_eur.readLines()[2].split('\t').toList() == ['90/90', '90', 'mind', '0.1', '0', '3934', '2', '123'] },
                // The cumulative counts at every rung equal those of plink2 run rung by rung.
                { assert ladder.study_eur.readLines().drop(1).findAll { line -> line.split('\t')[2] == 'mind' }.collect { line -> line.split('\t').toList()[[1, 5, 7]] } == [['90', '3934', '123'], ['91', '3934', '123'], ['92', '3934', '123'], ['93', '3934', '123'], ['94', '3934', '123'], ['95', '3931', '123'], ['96', '3929', '122'], ['97', '3929', '122'], ['98', '3929', '122'], ['99', '3899', '122']] },
                // The figure emits carry PDFs, whose bytes change with the creation time R writes into them,
                // so they are asserted for presence per stratum and left out of the content snapshot.
                { assert [workflow.out.vmiss_hist_plot, workflow.out.smiss_hist_plot, workflow.out.ladder_plot, workflow.out.hwe_hist_plot, workflow.out.hwe_window_plot].every { emission -> emission.size() == 2 && emission.every { entry -> path(entry[1]).size() > 0 && path(entry[2]).size() > 0 } } },
                { assert workflow.out.vmiss_hist_ylim_plot.size() == 2 && workflow.out.vmiss_hist_ylim_plot.every { entry -> path(entry[1]).size() > 0 } },
                { assert snapshot(sanitizeOutput(workflow.out).findAll { entry -> !entry.key.endsWith('_plot') }).match() },
            )
        }
    }

    // The EUR stratum beside its copy that also carries eight variants on alt and random contigs, each copied
    // from a common, complete, Hardy-Weinberg-conforming variant so that no later filter would drop it: the
    // copy's contig list names exactly those eight, and every other list and table equals the stratum's own.
    test("gwasqc fixtures - EUR stratum and its alt-contig copy") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'study_eur', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.fam', checkIfExists: true),
                    ],
                    [
                        [ id:'study_eur_alt', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/alt_contig/study_eur_alt.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/alt_contig/study_eur_alt.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/alt_contig/study_eur_alt.fam', checkIfExists: true),
                    ]
                )
                input[1] = 0.05
                input[2] = 0.05
                input[3] = 1e-10
                input[4] = 'iterative'
                """
            }
        }

        then {
            def contig_variants = (1..8).collect { i -> "AX-90000000${i}".toString() }
            def by_id = { emission -> emission.collectEntries { entry -> [(entry[0].id): path(entry[1])] } }
            def contig_exclude = by_id(workflow.out.contig_exclude)
            // Every single-file emission but the contig list and the figures, read per stratum.
            def compared = ['maf_snplist', 'vmiss', 'smiss', 'smiss_maf', 'geno_exclude', 'mind_remove', 'missingness_ladder', 'hardy', 'hardy_x', 'hwe_exclude', 'vmiss_hist_data', 'smiss_hist_data', 'hwe_hist_data', 'hwe_window_data']
            def text = { name -> by_id(workflow.out[name]).collectEntries { id, file -> [(id): file.text] } }
            assertAll(
                { assert workflow.success },
                { assert contig_exclude.study_eur_alt.readLines() == contig_variants },
                { assert contig_exclude.study_eur.readLines().isEmpty() },
                { assert compared.every { name -> text(name).size() == 2 && text(name).study_eur == text(name).study_eur_alt } },
                { assert !by_id(workflow.out.vmiss).study_eur_alt.text.contains('AX-9') },
                { assert snapshot(workflow.out.contig_exclude).match() },
            )
        }
    }

    // The EUR stratum beside its copy in which seven samples, EUR_S100 to EUR_S106, miss every call on chr1 and
    // chr2, 615 variants. Applied once, geno before mind, the 0.05 variant threshold removes the whole block,
    // whose rate is 7 / 125 = 0.056 and more, and the samples, then complete, are kept.
    test("gwasqc fixtures - EUR stratum and its missing-block copy - single") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'study_eur', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.fam', checkIfExists: true),
                    ],
                    [
                        [ id:'study_eur_missing_block', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/missing_block/study_eur_missing_block.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/missing_block/study_eur_missing_block.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/missing_block/study_eur_missing_block.fam', checkIfExists: true),
                    ]
                )
                input[1] = 0.05
                input[2] = 0.05
                input[3] = 1e-10
                input[4] = 'single'
                """
            }
        }

        then {
            def by_id = { emission -> emission.collectEntries { entry -> [(entry[0].id): path(entry[1])] } }
            def geno_exclude = by_id(workflow.out.geno_exclude)
            def mind_remove = by_id(workflow.out.mind_remove)
            def smiss = by_id(workflow.out.smiss)
            def smiss_maf = by_id(workflow.out.smiss_maf)
            def ladder = by_id(workflow.out.missingness_ladder)
            // The block is every variant of chromosomes 1 and 2, all of which pass MAF and so appear in the report.
            def block_variants = by_id(workflow.out.vmiss).study_eur_missing_block.readLines().drop(1).collect { line -> line.split('\t') }.findAll { fields -> fields[0] in ['1', '2'] }.collect { fields -> fields[1] }
            def obs_ct = { report -> report.readLines().drop(1).collect { line -> line.split('\t')[3] as Integer }.max() }
            assertAll(
                { assert workflow.success },
                { assert block_variants.size() == 615 },
                // The stratum itself: geno at 0.05 over all samples drops the twenty planted chr3 variants and
                // the four borderline chr4 variants above 0.05. The borderline sample sits at F_MISS 0.0501 over
                // the MAF-passing variants but at 0.0483 over the geno-retained ones, because eight of its
                // missing calls lie in the excluded variants; measured in the legacy order, it survives.
                { assert geno_exclude.study_eur.readLines().size() == 24 },
                { assert geno_exclude.study_eur.readLines().containsAll(['rs1395803', 'rs1406332', 'rs1499588', 'rs1500478', 'rs1501405', 'rs1502040']) },
                { assert mind_remove.study_eur.readLines() == ['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041'] },
                { assert obs_ct(smiss.study_eur) == 3954 - 24 },
                // The copy: the block goes with the 24 others, and the seven samples stay.
                { assert geno_exclude.study_eur_missing_block.readLines().size() == 639 },
                { assert geno_exclude.study_eur_missing_block.readLines().containsAll(block_variants) },
                { assert mind_remove.study_eur_missing_block.readLines() == ['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041'] },
                { assert obs_ct(smiss.study_eur_missing_block) == 3954 - 639 },
                // The pre-geno report the duplicate rule reads covers every MAF-passing variant and every sample:
                // the borderline sample is at its 0.0501 there and under the threshold in the applied report, and
                // the block samples still carry the block.
                { assert obs_ct(smiss_maf.study_eur) == 3954 },
                { assert smiss_maf.study_eur.readLines().find { line -> line.split('\t')[1] == 'EUR_S042' }.split('\t')[4] as Double > 0.05 },
                { assert smiss.study_eur.readLines().find { line -> line.split('\t')[1] == 'EUR_S042' }.split('\t')[4] as Double < 0.05 },
                { assert obs_ct(smiss_maf.study_eur_missing_block) == 3954 },
                { assert smiss_maf.study_eur_missing_block.readLines().size() == 126 },
                { assert smiss_maf.study_eur_missing_block.readLines().find { line -> line.split('\t')[1] == 'EUR_S100' }.split('\t')[4] as Double > 0.15 },
                // The ladder is computed in either mode.
                { assert ladder.study_eur_missing_block.readLines().size() == 21 },
            )
        }
    }

    // The same pair on the cumulative ladder up to call rate 95: rung 90 removes the seven block samples, whose
    // F_MISS is 0.156, and the block variants, then missing in no remaining sample, survive every rung.
    test("gwasqc fixtures - EUR stratum and its missing-block copy - iterative") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'study_eur', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.fam', checkIfExists: true),
                    ],
                    [
                        [ id:'study_eur_missing_block', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/missing_block/study_eur_missing_block.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/missing_block/study_eur_missing_block.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/missing_block/study_eur_missing_block.fam', checkIfExists: true),
                    ]
                )
                input[1] = 0.05
                input[2] = 0.05
                input[3] = 1e-10
                input[4] = 'iterative'
                """
            }
        }

        then {
            def by_id = { emission -> emission.collectEntries { entry -> [(entry[0].id): path(entry[1])] } }
            def geno_exclude = by_id(workflow.out.geno_exclude)
            def mind_remove = by_id(workflow.out.mind_remove)
            def smiss_maf = by_id(workflow.out.smiss_maf)
            def ladder = by_id(workflow.out.missingness_ladder)
            // The block is every variant of chromosomes 1 and 2, all of which pass MAF and so appear in the report.
            def block_variants = by_id(workflow.out.vmiss).study_eur_missing_block.readLines().drop(1).collect { line -> line.split('\t') }.findAll { fields -> fields[0] in ['1', '2'] }.collect { fields -> fields[1] }
            def obs_ct = { report -> report.readLines().drop(1).collect { line -> line.split('\t')[3] as Integer }.max() }
            def block_samples = (100..106).collect { n -> "EUR_S${n} EUR_S${n}".toString() }
            assertAll(
                { assert workflow.success },
                { assert mind_remove.study_eur_missing_block.readLines().sort() == (['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041'] + block_samples).sort() },
                { assert geno_exclude.study_eur_missing_block.readLines().size() == 25 },
                { assert geno_exclude.study_eur_missing_block.readLines().intersect(block_variants).isEmpty() },
                // The stratum without the block is unaffected by its copy.
                { assert geno_exclude.study_eur.readLines().size() == 23 },
                { assert mind_remove.study_eur.readLines() == ['EUR_S040 EUR_S040', 'EUR_S041 EUR_S041'] },
                // Rung 90's sample step removes all nine at once.
                { assert ladder.study_eur_missing_block.readLines()[2].split('\t').toList() == ['90/90', '90', 'mind', '0.1', '0', '3934', '9', '116'] },
                // The pre-geno report the duplicate rule reads is no rung's: it covers every MAF-passing variant and
                // still lists the nine samples the ladder removes, the block samples with the block missing.
                { assert obs_ct(smiss_maf.study_eur_missing_block) == 3954 },
                { assert smiss_maf.study_eur_missing_block.readLines().size() == 126 },
                { assert smiss_maf.study_eur_missing_block.readLines().find { line -> line.split('\t')[1] == 'EUR_S100' }.split('\t')[4] as Double > 0.15 },
            )
        }
    }

    test("gwasqc fixtures - two strata - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'study_eur', ancestry:'EUR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_eur.fam', checkIfExists: true),
                    ],
                    [
                        [ id:'study_afr', ancestry:'AFR' ],
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_afr.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_afr.bim', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'data/gwasqc/genotypes/study_afr.fam', checkIfExists: true),
                    ]
                )
                input[1] = 0.05
                input[2] = 0.05
                input[3] = 1e-10
                input[4] = 'iterative'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.hwe_exclude.collect { entry -> entry[0].id }.sort() == ['study_afr', 'study_eur'] },
                { assert workflow.out.missingness_ladder.collect { entry -> entry[0].id }.sort() == ['study_afr', 'study_eur'] },
                { assert snapshot(sanitizeOutput(workflow.out)).match() },
            )
        }
    }
}
