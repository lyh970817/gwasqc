process {
    // The MAF threshold reaches plink2 as native optional behaviour; the pipeline sets it from `params.maf` in
    // `conf/modules/plink2.config`, which is loaded here too, so this block only pins the test's own value.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args = '--maf 0.01'
    }
}
