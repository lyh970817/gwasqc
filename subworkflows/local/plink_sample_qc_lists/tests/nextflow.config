process {
    // The pipeline's per-family configs are loaded from the project root: the sex-check PAR split and
    // thresholds, the kinship filter, the MAF threshold and the reference-side filters reach plink2 from
    // `params` exactly as in a pipeline run, so this file only pins the values the test relies on. The
    // small-sample overrides are pinned with them: plink2 refuses `--indep-pairwise`, `--check-sex` and
    // `--het` below 50 samples, and the 12-sample stratum reaches the sex check in either mode.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args = '--maf 0.01'
    }
    // The selector above also reaches the ancestry-stage aliases, which run the study-side ancestry filters.
    withName: 'PLINK2_WRITESNPLIST_ANCESTRY' {
        ext.args = '--geno 0.02 --maf 0.01 --hwe 0.000001'
    }
    withName: 'PLINK2_WRITESNPLIST_ANCESTRY_SMALL' {
        ext.args = '--geno 0.02'
    }
    withName: 'PLINK2_SCORE_REFERENCE|PLINK2_SCORE_STUDY' {
        ext.args = '--score-col-nums 6-15'
    }
    withName: 'PLINK2_INDEPPAIRWISE' {
        ext.args = '--bad-ld'
    }
    // The selector above also reaches the reference pruning aliases, which run the reference-side filters.
    withName: 'PLINK2_INDEPPAIRWISE_REFERENCE|PLINK2_INDEPPAIRWISE_MATCHED' {
        ext.args = '--geno 0.02 --maf 0.01 --hwe 0.000001'
    }
    withName: 'PLINK2_CHECKSEX' {
        ext.args  = '--split-par b38 --bad-freqs'
        ext.args2 = 'max-female-xf=0.2 min-male-xf=0.8 max-female-ycount=0 min-male-ycount=1 cols=+ycount'
    }
    withName: 'PLINK2_MAKEKINGTABLE' {
        ext.args = '--king-table-filter 0.0442'
    }
}
