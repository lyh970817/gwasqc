process {
    // The pipeline's per-family configs are loaded from the project root: the reference-side filters, the
    // weight-file layout and the projection modifiers reach plink2 from `params` exactly as in a pipeline
    // run, so this file only pins the values the test relies on.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args = '--maf 0.01'
    }
    withName: 'PLINK2_MAKEBED_REFERENCE' {
        ext.args = '--maf 0.01 --geno 0.05'
    }
    withName: 'PLINK2_SCORE_REFERENCE|PLINK2_SCORE_STUDY' {
        ext.args = '--score-col-nums 6-15'
    }
}
