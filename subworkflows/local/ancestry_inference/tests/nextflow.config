process {
    // The pipeline's per-family configs are loaded from the project root: the ancestry-stage filters, the
    // weight-file layout and the projection modifiers reach plink2 from `params` exactly as in a pipeline
    // run, so this file only pins the values the test relies on. A selector on a base process reaches its
    // aliases and this file is read last, so the ancestry-stage aliases of the keep-list atom are pinned
    // after it: the study-side filters, all three above 100 samples and the missingness alone at or below,
    // and the same three on the two reference pruning runs.
    withName: 'PLINK2_WRITESNPLIST' {
        ext.args = '--maf 0.01'
    }
    withName: 'PLINK2_WRITESNPLIST_ANCESTRY' {
        ext.args = '--geno 0.02 --maf 0.01 --hwe 0.000001'
    }
    withName: 'PLINK2_WRITESNPLIST_ANCESTRY_SMALL' {
        ext.args = '--geno 0.02'
    }
    withName: 'PLINK2_INDEPPAIRWISE_REFERENCE|PLINK2_INDEPPAIRWISE_MATCHED' {
        ext.args = '--geno 0.02 --maf 0.01 --hwe 0.000001'
    }
    withName: 'PLINK2_SCORE_REFERENCE|PLINK2_SCORE_STUDY' {
        ext.args = '--score-col-nums 6-15'
    }
}
