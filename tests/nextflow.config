/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    // `pipelines_testdata_base_path` is deliberately not set here. The test profile's fixture resolver
    // (`conf/test_fixtures.config`) derives it from GWASQC_TEST_FIXTURES or the pipeline default, and a value
    // set through this `-c` file would override that resolution at runtime without reaching the profile.
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

// Every test case is a separate `nextflow run`, and the pipeline enables `timeline`, `report`, `trace` and
// `dag` outside any profile, so each case would render all four into an `outdir` no assertion reads. The three
// renderers are turned off here; `trace` is left alone because nf-test passes its own `-with-trace` and reads it.
timeline.enabled = false
report.enabled = false
dag.enabled = false
