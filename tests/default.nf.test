nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "default"

    // The profile owns the fixture samplesheet; `outdir` is the only override, so this exercises the same
    // configuration a researcher invokes directly: two 125-sample strata and one 12-sample stratum under the
    // default `auto` marker-set mode, which sends the small stratum to the shared marker set and keeps the
    // large ones on their own pruned variants.
    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def lines = { relative -> new File("${params.outdir}/${relative}").readLines() }
            def large = ['study_eur', 'study_afr']
            def strata = large + ['study_csa']
            def prefix = { id -> id.replace('study_', '').toUpperCase() }
            def relationships = { id ->
                lines("qc/${id}/relatedness/${id}.relatedness_pairs.tsv").drop(1).collect { line -> line.split('\t') }.collectEntries { fields -> [([fields[1], fields[3]].sort().join('/')): fields[9]] }
            }
            def mhc_block = ['rs1691803', 'rs1692225', 'rs1692986', 'rs1693180', 'rs1693565', 'rs1694305', 'rs1695168', 'rs1695930', 'rs1696394', 'rs1696687', 'rs1697113', 'rs1697536', 'rs1697583', 'rs1698450', 'rs1699148', 'rs1699176', 'rs1699973', 'rs1700763', 'rs1701059', 'rs1701798', 'rs1701848', 'rs1702222', 'rs1702918', 'rs1703899', 'rs1704251', 'rs1704269', 'rs1704945', 'rs1705262', 'rs1705437', 'rs1706350', 'rs1706917', 'rs1707913', 'rs1708405', 'rs1708542', 'rs1709245', 'rs1709713', 'rs1710071', 'rs1710602']
            def flipped = ['rs1019157', 'rs1084781', 'rs1090252', 'rs1097655', 'rs1145782', 'rs1159607', 'rs1163718', 'rs1273151', 'rs1360139', 'rs1389123', 'rs1436911', 'rs1452101', 'rs1467337', 'rs1549826', 'rs1578801', 'rs1677459', 'rs1680161', 'rs1722029', 'rs1723746', 'rs1762883', 'rs1776206', 'rs1803389', 'rs1862912', 'rs1916892', 'rs1941077', 'rs1988230', 'rs1996775', 'rs2027882', 'rs2109777', 'rs2130274', 'rs2144516', 'rs2150265', 'rs2164106', 'rs2169905', 'rs2281679', 'rs2294093', 'rs2309898', 'rs2314061', 'rs2347169', 'rs2362593', 'rs2389678', 'rs2439958', 'rs2469140', 'rs2504154', 'rs2515327', 'rs2516136', 'rs2517896', 'rs2524188', 'rs2526561', 'rs2637925', 'rs2675388', 'rs2729284', 'rs2781271', 'rs2789194']
            def ambiguous = ['rs1008974', 'rs1111502', 'rs1117409', 'rs1212885', 'rs1239733', 'rs1301534', 'rs1323806', 'rs1325713', 'rs1462042', 'rs1515061', 'rs1532976', 'rs1540256', 'rs1617881', 'rs1630597', 'rs1648278', 'rs1658669', 'rs1676231', 'rs1678804', 'rs1685698', 'rs1719304', 'rs1801805', 'rs1810040', 'rs1880092', 'rs2032830', 'rs2036157', 'rs2115243', 'rs2140434', 'rs2173298', 'rs2239178', 'rs2293247', 'rs2339427', 'rs2417072', 'rs2489817', 'rs2586694', 'rs2670145', 'rs2679890', 'rs2693456', 'rs2696100', 'rs2779816', 'rs2814949']
            def planted = [study_eur: [EUR_S050: 'EAS', EUR_S051: 'AFR', EUR_S052: 'AMR'], study_afr: [AFR_S050: 'EUR', AFR_S051: 'CSA', AFR_S052: 'EAS']]
            def harmonisation = { id -> lines("qc/${id}/ancestry/${id}.ancestry_harmonisation.tsv").drop(1).collect { line -> line.split('\t', -1) }.collectEntries { fields -> [(fields[0]): fields[7]] } }
            def assigned = { id -> lines("qc/${id}/ancestry/${id}.ancestry_assignment.tsv").drop(1).collect { line -> line.split('\t') }.collectEntries { fields -> [(fields[1]): fields[2]] } }
            // The cross-stratum summary as one map per stratum, and the published tree per stage as the
            // documented layout (docs/output.md) demands it: nothing more, nothing less.
            def summary_rows = lines('gwasqc_summary.tsv').collect { line -> line.split('\t', -1).toList() }
            def summary = summary_rows.drop(1).collectEntries { fields -> [(fields[0]): [summary_rows[0], fields].transpose().collectEntries { column, value -> [(column): value] }] }
            def published = { id, stage -> new File("${params.outdir}/qc/${id}/${stage}").list().toList().collect { name -> name.replace("${id}.", '<id>.') }.sort() }
            def heterozygosity_files = ['<id>.het', '<id>.het_hist.pdf', '<id>.het_hist.png', '<id>.het_hist.tsv', '<id>.het_sex_scatter.pdf', '<id>.het_sex_scatter.png', '<id>.het_sex_scatter.tsv']
            def layout = [
                maf: ['<id>.maf.snplist'],
                missingness: ['<id>.geno_exclude.txt', '<id>.mind_remove.txt', '<id>.missingness_ladder.pdf', '<id>.missingness_ladder.png', '<id>.missingness_ladder.tsv', '<id>.smiss', '<id>.smiss_hist.pdf', '<id>.smiss_hist.png', '<id>.smiss_hist.tsv', '<id>.vmiss', '<id>.vmiss_hist.pdf', '<id>.vmiss_hist.png', '<id>.vmiss_hist.tsv'],
                hwe: ['<id>.hardy', '<id>.hardy.x', '<id>.hwe_exclude.txt', '<id>.hwe_hist.pdf', '<id>.hwe_hist.png', '<id>.hwe_hist.tsv', '<id>.hwe_hist_window.pdf', '<id>.hwe_hist_window.png', '<id>.hwe_hist_window.tsv'],
                sex_check: ['<id>.sex_check_hist.pdf', '<id>.sex_check_hist.png', '<id>.sex_check_hist.tsv', '<id>.sex_mismatch.tsv', '<id>.sex_mismatch_remove.txt', '<id>.sexcheck'],
                relatedness: ['<id>.relatedness_hist.pdf', '<id>.relatedness_hist.png', '<id>.relatedness_hist.tsv', '<id>.relatedness_indiv.tsv', '<id>.relatedness_outliers.txt', '<id>.relatedness_pairs.tsv', '<id>.relatedness_remove.txt'],
                ancestry: ['<id>.ancestry.eigenval', '<id>.ancestry.highld_exclude.txt', '<id>.ancestry.prune.in', '<id>.ancestry_AFR.keep', '<id>.ancestry_AMR.keep', '<id>.ancestry_CSA.keep', '<id>.ancestry_EAS.keep', '<id>.ancestry_EUR.keep', '<id>.ancestry_assignment.tsv', '<id>.ancestry_flip_update.txt', '<id>.ancestry_harmonisation.tsv', '<id>.ancestry_harmonisation_summary.tsv', '<id>.ancestry_harmonised.snplist', '<id>.ancestry_mismatch_remove.txt', '<id>.ancestry_model.tsv', '<id>.ancestry_pc1_pc2.pdf', '<id>.ancestry_pc1_pc2.png', '<id>.ancestry_pc3_pc4.pdf', '<id>.ancestry_pc3_pc4.png', '<id>.ancestry_pca.tsv', '<id>.ancestry_summary.tsv'],
            ]
            // The study mode adds the pruning stage; the shared mode adds the reference baseline files beside
            // the heterozygosity report and has no pruning stage.
            def study_layout = layout + [ld_pruning: ['<id>.highld_exclude.txt', '<id>.prune.in'], heterozygosity: heterozygosity_files]
            def shared_layout = layout + [heterozygosity: (heterozygosity_files + ['<id>.reference.afreq', '<id>.reference.het', '<id>.reference_keep.txt']).sort()]
            def report = new File("${params.outdir}/multiqc/multiqc_report.html").text
            def sections = ['gwasqc_qc_summary', 'gwasqc_variant_qc', 'gwasqc_variant_qc_filters', 'gwasqc_variant_qc_ladder', 'gwasqc_sample_qc_markers', 'gwasqc_sex_check', 'gwasqc_sex_check_summary', 'gwasqc_sex_check_mismatches', 'gwasqc_heterozygosity', 'gwasqc_heterozygosity_summary', 'gwasqc_relatedness', 'gwasqc_relatedness_summary', 'gwasqc_relatedness_pairs', 'gwasqc_ancestry', 'gwasqc_ancestry_summary', 'gwasqc_sample_removals'] + strata.collectMany { id -> ['variant_qc', 'sex_check', 'heterozygosity', 'relatedness', 'ancestry'].collect { stage -> "gwasqc_${stage}_plots_${id}".toString() } }
            def het_hist = { id -> lines("qc/${id}/heterozygosity/${id}.het_hist.tsv").drop(1).collect { line -> line.split('\t').toList() } }
            assertAll(
                { assert workflow.success },
                { assert new File("${params.outdir}").list().toList().sort() == ['genotypes', 'gwasqc_summary.tsv', 'multiqc', 'pipeline_info', 'qc'] },
                { assert large.every { id -> new File("${params.outdir}/qc/${id}").list().toList().sort() == ['ancestry', 'heterozygosity', 'hwe', 'ld_pruning', 'maf', 'missingness', 'relatedness', 'sex_check'] } },
                { assert new File("${params.outdir}/qc/study_csa").list().toList().sort() == ['ancestry', 'heterozygosity', 'hwe', 'maf', 'missingness', 'relatedness', 'sex_check'] },
                { assert large.every { id -> study_layout.every { stage, files -> published(id, stage) == files } } },
                { assert shared_layout.every { stage, files -> published('study_csa', stage) == files } },
                { assert strata.every { id -> new File("${params.outdir}/genotypes/${id}").list().toList().sort() == ["${id}.qc.bed", "${id}.qc.bim", "${id}.qc.fam"].collect { name -> name.toString() } } },
                // The cross-stratum summary: one row per stratum in id order, every count consistent with the
                // planted defects and with the lists and filesets it was counted from.
                { assert summary_rows.drop(1).collect { fields -> fields[0] } == ['study_afr', 'study_csa', 'study_eur'] },
                { assert summary.study_eur.subMap(['ancestry', 'samples_input', 'variants_input', 'maf_threshold', 'variants_maf_removed', 'geno_threshold', 'variants_geno_removed', 'mind_threshold', 'samples_mind_removed', 'hwe_threshold', 'variants_hwe_removed']) == [ancestry: 'EUR', samples_input: '125', variants_input: '3962', maf_threshold: '0.01', variants_maf_removed: '8', geno_threshold: '0.05', variants_geno_removed: '24', mind_threshold: '0.05', samples_mind_removed: '2', hwe_threshold: '1e-10', variants_hwe_removed: '5'] },
                { assert summary.study_afr.subMap(['ancestry', 'samples_input', 'variants_input', 'variants_maf_removed', 'samples_mind_removed', 'variants_hwe_removed']) == [ancestry: 'AFR', samples_input: '125', variants_input: '3962', variants_maf_removed: '9', samples_mind_removed: '2', variants_hwe_removed: '5'] },
                { assert large.every { id -> summary[id].subMap(['sex_check_problems', 'sex_removals', 'relatedness_duplicate_or_mz', 'relatedness_parent_offspring', 'relatedness_full_sibling', 'relatedness_removed', 'relatedness_removals', 'ancestry_unassigned', 'ancestry_mismatches', 'ancestry_removals']) == [sex_check_problems: '2', sex_removals: 'listed only', relatedness_duplicate_or_mz: '1', relatedness_parent_offspring: '1', relatedness_full_sibling: '1', relatedness_removed: '1', relatedness_removals: 'listed only', ancestry_unassigned: '0', ancestry_mismatches: '3', ancestry_removals: 'listed only'] } },
                { assert large.every { id -> summary[id]["ancestry_n_${prefix(id)}".toString()] == '120' } },
                // The marker-set mode: `auto` keeps the 125-sample strata on their own pruned variants and
                // sends the 12-sample stratum to the shared set, whose pruning columns read NA and whose check
                // markers are the ancestry route's pruned list; no note is raised, as the fixture has no LD.
                { assert large.every { id -> summary[id].subMap(['samples_after_mind', 'sample_qc_marker_set', 'sample_qc_note']) == [samples_after_mind: '123', sample_qc_marker_set: 'study', sample_qc_note: ''] } },
                { assert large.every { id -> summary[id].sample_qc_markers == (lines("qc/${id}/ld_pruning/${id}.prune.in").size() - lines("qc/${id}/ld_pruning/${id}.highld_exclude.txt").size()).toString() } },
                { assert summary.study_csa.subMap(['ancestry', 'samples_input', 'variants_input', 'samples_mind_removed', 'samples_after_mind', 'variants_hwe_removed', 'variants_ld_pruned_in', 'variants_ld_pruned_out', 'variants_highld_excluded', 'variants_sample_checks', 'sample_qc_marker_set', 'sample_qc_note']) == [ancestry: 'CSA', samples_input: '12', variants_input: '3962', samples_mind_removed: '0', samples_after_mind: '12', variants_hwe_removed: '0', variants_ld_pruned_in: 'NA', variants_ld_pruned_out: 'NA', variants_highld_excluded: 'NA', variants_sample_checks: 'NA', sample_qc_marker_set: 'shared', sample_qc_note: ''] },
                { assert summary.study_csa.sample_qc_markers == lines('qc/study_csa/ancestry/study_csa.ancestry.prune.in').size().toString() },
                // The small stratum's planted defects: the one sex mismatch, the one duplicate pair with one
                // member listed, all twelve samples assigned CSA; the gate is off, so nothing leaves the fileset.
                { assert summary.study_csa.subMap(['sex_check_problems', 'relatedness_duplicate_or_mz', 'relatedness_removed', 'ancestry_n_CSA', 'ancestry_unassigned', 'ancestry_mismatches', 'samples_removed_under_gate', 'samples_removed', 'samples_final', 'het_samples']) == [sex_check_problems: '1', relatedness_duplicate_or_mz: '1', relatedness_removed: '1', ancestry_n_CSA: '12', ancestry_unassigned: '0', ancestry_mismatches: '0', samples_removed_under_gate: '2', samples_removed: '0', samples_final: '12', het_samples: '12'] },
                { assert lines('qc/study_csa/sex_check/study_csa.sex_mismatch_remove.txt') == ['CSA_S010 CSA_S010'] },
                { assert relationships('study_csa')['CSA_S005/CSA_S006'] == 'duplicate_or_mz' },
                { assert lines('qc/study_csa/relatedness/study_csa.relatedness_remove.txt').size() == 1 },
                { assert lines('qc/study_csa/missingness/study_csa.mind_remove.txt').isEmpty() },
                // The shared stratum's heterozygosity baseline: the 50 CSA reference samples, their frequency
                // table over exactly the shared markers, their own report over the same markers, and the
                // histogram data carrying both sources over one set of bins.
                { assert lines('qc/study_csa/heterozygosity/study_csa.reference_keep.txt').size() == 50 },
                { assert lines('qc/study_csa/heterozygosity/study_csa.reference_keep.txt').every { line -> line.split(' ')[1].startsWith('GIH_') || line.split(' ')[1].startsWith('PJL_') } },
                { assert lines('qc/study_csa/heterozygosity/study_csa.reference.afreq').drop(1).collect { line -> line.split('\t')[1] }.sort() == lines('qc/study_csa/ancestry/study_csa.ancestry.prune.in').sort() },
                { assert lines('qc/study_csa/heterozygosity/study_csa.reference.het').size() == 51 },
                { assert het_hist('study_csa').collect { fields -> fields[0] }.unique() == ['study', 'reference'] },
                { assert het_hist('study_csa').findAll { fields -> fields[0] == 'study' }.sum { fields -> fields[3] as Integer } == 12 },
                { assert het_hist('study_csa').findAll { fields -> fields[0] == 'reference' }.sum { fields -> fields[3] as Integer } == 50 },
                { assert large.every { id -> het_hist(id).collect { fields -> fields[0] }.unique() == ['study'] } },
                // The gate is off: the large filesets lost the two mind removals, and the union of the eight
                // listed samples is what the gate would remove.
                { assert large.every { id -> summary[id].subMap(['samples_removed_under_gate', 'samples_removed', 'samples_final']) == [samples_removed_under_gate: '8', samples_removed: '2', samples_final: '123'] } },
                { assert strata.every { id -> summary[id].variants_final == lines("genotypes/${id}/${id}.qc.bim").size().toString() && summary[id].variants_after_hwe == summary[id].variants_final } },
                { assert large.every { id -> summary[id].variants_ld_pruned_in == lines("qc/${id}/ld_pruning/${id}.prune.in").size().toString() && summary[id].het_samples == '123' } },
                // The MultiQC report renders every section: the summary, the marker-set table, one parent per
                // stage with its tables, and one figure section per stratum and stage.
                { assert sections.every { section -> report.contains("id=\"${section}\"") } },
                { assert report.contains('data:image/png;base64,') },
                // Ancestry: the documented strand flips are the flip list and the ambiguous pairs are dropped,
                // within the intersect of the reference with the QC'd variant set; the reference classifies
                // itself perfectly leave-one-out; exactly the planted outliers leave the stratum's label, each to
                // the super-population it was drawn from, and every other projected sample keeps it.
                { assert strata.every { id -> harmonisation(id).findAll { _variant, group -> group == 'flip' }.keySet().sort() == flipped.intersect(harmonisation(id).keySet()).sort() } },
                { assert strata.every { id -> harmonisation(id).findAll { _variant, group -> group == 'ambiguous' }.keySet().sort() == ambiguous.intersect(harmonisation(id).keySet()).sort() } },
                { assert strata.every { id -> lines("qc/${id}/ancestry/${id}.ancestry_harmonised.snplist").intersect(ambiguous).isEmpty() } },
                { assert strata.every { id -> lines("qc/${id}/ancestry/${id}.ancestry_flip_update.txt").collect { line -> line.split('\t')[0] }.sort() == flipped.intersect(harmonisation(id).keySet()).sort() } },
                { assert strata.every { id -> lines("qc/${id}/ancestry/${id}.ancestry_model.tsv").drop(1).collect { line -> line.split('\t') }.findAll { fields -> fields[0] == fields[1] }.sum { fields -> fields[2] as Integer } == 250 } },
                { assert large.every { id -> assigned(id).findAll { _iid, group -> group != prefix(id) } == planted[id] } },
                { assert strata.every { id -> assigned(id).size() == lines("qc/${id}/maf/../missingness/${id}.smiss").size() - 1 - lines("qc/${id}/missingness/${id}.mind_remove.txt").size() || assigned(id).size() == (id == 'study_csa' ? 12 : 123) } },
                { assert assigned('study_csa').values().every { group -> group == 'CSA' } },
                { assert large.every { id -> lines("qc/${id}/ancestry/${id}.ancestry_mismatch_remove.txt") == planted[id].keySet().collect { iid -> "${iid} ${iid}".toString() } } },
                { assert large.every { id -> lines("qc/${id}/ancestry/${id}.ancestry_${prefix(id)}.keep").size() == assigned(id).size() - 3 } },
                // Planted defects from the fixture README, for the large strata. Missingness in the legacy
                // order: the two high-missingness samples fall, and the borderline one survives because its rate
                // over the geno-retained variants drops below the threshold; the twenty planted variants fall at
                // geno.
                { assert large.every { id -> lines("qc/${id}/missingness/${id}.mind_remove.txt") == ["${prefix(id)}_S040 ${prefix(id)}_S040", "${prefix(id)}_S041 ${prefix(id)}_S041"] } },
                { assert strata.every { id -> lines("qc/${id}/missingness/${id}.geno_exclude.txt").size() >= 20 } },
                { assert strata.every { id -> lines("qc/${id}/missingness/${id}.missingness_ladder.tsv").size() == 11 } },
                { assert large.every { id -> lines("qc/${id}/hwe/${id}.hwe_exclude.txt") == ['rs1667531', 'rs1668208', 'rs1668410', 'rs1668428', 'rs1668730'] } },
                // In the 12-sample stratum one missing call is 8.3 % of the samples, so every variant the sparse
                // sample misses falls at geno, while the sparse sample itself stays; the HWE plants are not
                // detectable at that sample size.
                { assert lines('qc/study_csa/missingness/study_csa.geno_exclude.txt').containsAll(['rs1151545', 'rs1311999', 'rs1911972', 'rs2167038', 'rs2770893']) },
                { assert lines('qc/study_csa/hwe/study_csa.hwe_exclude.txt').isEmpty() },
                // Exactly the two planted sex mismatches of the large strata, in the table and in the removal list.
                { assert large.every { id -> lines("qc/${id}/sex_check/${id}.sex_mismatch_remove.txt") == ["${prefix(id)}_S010 ${prefix(id)}_S010", "${prefix(id)}_S011 ${prefix(id)}_S011"] } },
                { assert large.every { id -> lines("qc/${id}/sex_check/${id}.sex_mismatch.tsv").size() == 3 } },
                // The duplicate pair is classified as such with one member listed, and the two first-degree
                // pairs are separated by IBS0.
                { assert large.every { id -> relationships(id)["${prefix(id)}_S020/${prefix(id)}_S021"] == 'duplicate_or_mz' } },
                { assert large.every { id -> relationships(id)["${prefix(id)}_S030/${prefix(id)}_S031"] == 'parent_offspring' } },
                { assert large.every { id -> relationships(id)["${prefix(id)}_S032/${prefix(id)}_S033"] == 'full_sibling' } },
                { assert large.every { id -> lines("qc/${id}/relatedness/${id}.relatedness_remove.txt").size() == 1 && lines("qc/${id}/relatedness/${id}.relatedness_remove.txt")[0] in ["${prefix(id)}_S020 ${prefix(id)}_S020".toString(), "${prefix(id)}_S021 ${prefix(id)}_S021".toString()] } },
                // The long-range LD exclusion holds every pruned variant of the planted MHC block and only pruned
                // variants; the fixture has no LD structure, so pruning itself removes little.
                { assert large.every { id -> lines("qc/${id}/ld_pruning/${id}.prune.in").containsAll(lines("qc/${id}/ld_pruning/${id}.highld_exclude.txt")) } },
                { assert large.every { id -> lines("qc/${id}/ld_pruning/${id}.highld_exclude.txt").containsAll(mhc_block.intersect(lines("qc/${id}/ld_pruning/${id}.prune.in"))) } },
                // One fileset written once, whose sizes reconcile with the lists it was built from; the sex and
                // relatedness lists are published only, so the sample count drops by the mind removals alone.
                {
                    assert strata.every { id ->
                        def kept = lines("qc/${id}/maf/${id}.maf.snplist").size() - lines("qc/${id}/missingness/${id}.geno_exclude.txt").size() - lines("qc/${id}/hwe/${id}.hwe_exclude.txt").size()
                        lines("genotypes/${id}/${id}.qc.bim").size() == kept
                    }
                },
                { assert large.every { id -> lines("genotypes/${id}/${id}.qc.fam").size() == 125 - lines("qc/${id}/missingness/${id}.mind_remove.txt").size() } },
                { assert lines('genotypes/study_csa/study_csa.qc.fam').size() == 12 },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('GWASQC:PLINK2_MAKEBED (') }.size() == 3 },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('PLINK2_INDEPPAIRWISE (') && !task.name.contains('REFERENCE') }.size() == 2 },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('PLINK2_HET_REFERENCE (') }.size() == 1 },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_gwasqc_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    // Stubs are driven from the same scenario with narrowed assertions: the file tree, not the content.
    test("-profile test - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            assertAll(
                { assert workflow.success },
                { assert new File("${params.outdir}").list().toList().sort() == ['genotypes', 'gwasqc_summary.tsv', 'multiqc', 'pipeline_info', 'qc'] },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('GWASQC:PLINK2_MAKEBED (') }.size() == 3 },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('GWASQC:STRATUM_REPORT (') }.size() == 3 },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('GWASQC:QC_SUMMARY') }.size() == 1 },
                // The stub mind list is empty, so `auto` decides on the input counts: the small stratum alone
                // takes the shared branch.
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('PLINK2_HET_REFERENCE (') }.size() == 1 },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_gwasqc_software_mqc_versions.yml"),
                    stable_path
                ).match() }
            )
        }
    }
}
